#!/bin/sh

echo "===================================="
echo " PRE-COMMIT - CONTROL DE CALIDAD"
echo "===================================="

echo ""
echo "[1/3] Ejecutando Formatter..."
mvn spotless:check

if [ $? -ne 0 ]; then
    echo "ERROR: Falló el Formatter."
    echo "Commit rechazado."
    exit 1
fi

echo "Formatter OK"

echo ""
echo "[2/3] Ejecutando Linter..."
mvn pmd:check

if [ $? -ne 0 ]; then
    echo "ERROR: Falló el análisis estático."
    echo "Commit rechazado."
    exit 1
fi

echo "Linter OK"

echo ""
echo "[3/3] Ejecutando pruebas unitarias..."
mvn test

if [ $? -ne 0 ]; then
    echo "ERROR: Fallaron las pruebas."
    echo "Commit rechazado."
    exit 1
fi

echo "Tests OK"

echo ""
echo "===================================="
echo " CALIDAD OK - COMMIT PERMITIDO"
echo "===================================="

exit 0